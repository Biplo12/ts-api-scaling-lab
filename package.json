{
  "name": "ts-api-scaling-lab",
  "version": "1.0.0",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@1.22.22",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24.13.3",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "pg-copy-streams": "^7.0.0",
    "prettier": "^3.9.6",
    "tsc": "^2.0.4",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/scripts/seed.ts",
    "start:bench": "cross-env LOG_LEVEL=error node --env-file=.env --enable-source-maps dist/index.js",
    "bench": "k6 run bench/load.js",
    "bench:ceiling": "k6 run bench/ceiling.js"
  },
  "type": "module",
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "pg": "^8.23.0"
  }
}
